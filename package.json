{
  "name": "chrollis.github.io",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "Chrollis personal homepage — Arknights-inspired industrial editorial design",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-icons.mjs && node scripts/build-feeds.mjs",
    "icons": "node scripts/build-icons.mjs",
    "feeds": "node scripts/build-feeds.mjs",
    "prebuild": "node scripts/build-icons.mjs && node scripts/build-feeds.mjs && node scripts/fetch-github.mjs",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "build:only": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"*.{ts,js,json,md}\"",
    "typecheck": "tsc -b",
    "data:fetch": "node scripts/fetch-github.mjs",
    "audit:curation": "node scripts/audit-curation.mjs",
    "audit:strings": "node scripts/audit-strings.mjs",
    "test:curation": "node scripts/verify-curation.mjs"
  },
  "dependencies": {
    "@fontsource/blinker": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "flexsearch": "^0.8.212",
    "framer-motion": "^13.2.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.44.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
